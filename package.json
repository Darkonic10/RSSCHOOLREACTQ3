{
  "name": "class-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "next dev",
    "build": "next build",
    "type-check": "tsc -b --noEmit",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint": "eslint src --ext .ts,.tsx,.html",
    "lint:fix": "eslint src --fix --ext .ts,.tsx,.html",
    "stylelint": "stylelint src/**/*.css",
    "stylelint:fix": "stylelint --fix src/**/*.css",
    "lint-staged": "lint-staged",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "deploy": "npm run build && cp dist/index.html dist/404.html && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.2",
    "colorthief": "^2.6.0",
    "modern-normalize": "^3.0.1",
    "next": "^15.4.6",
    "next-intl": "^4.3.4",
    "react": "^19.1.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/colorthief": "^2.6.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "stylelint": "^16.21.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  }
}
